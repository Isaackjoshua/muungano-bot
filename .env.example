GEMINI_API_KEY=AIza...

# Optional: override the default model (gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# --- Meta WhatsApp Cloud API (free production channel) ------------------
# Only needed if you serve the bot over Meta's Cloud API (POST /meta/webhook)
# instead of / in addition to the Twilio sandbox. Leave unset to run Twilio
# only. See README "Deploying live on WhatsApp for free".
# META_VERIFY_TOKEN=some-random-string-you-choose
# META_ACCESS_TOKEN=EAAG...          # Graph API token used to send replies
# META_PHONE_NUMBER_ID=123456789012345
# GRAPH_API_VERSION=v22.0            # optional; this is the default
